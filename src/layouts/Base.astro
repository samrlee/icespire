---
import EntityLinks from '../components/EntityLinks.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { url } from '../utils/url';
import '../styles/global.css';
import '../styles/print.css';
import { validateContent } from '../lib/validate-content';

await validateContent();

interface Props {
  title: string;
  description?: string;
  // Path under /public for the social preview image, overridable per page.
  ogImage?: string;
  // Exceptional flat-file routes, such as Cloudflare's 404.html.
  canonicalPath?: string;
  printable?: boolean;
  linkEntities?: boolean;
}

const {
  title,
  description = 'A chronicle of our Dragon of Icespire Peak campaign.',
  ogImage = '/images/social-card.jpg',
  canonicalPath = Astro.url.pathname,
  printable = false,
  linkEntities = true,
} = Astro.props;

const fullTitle = `${title} · Dragon of Icespire Peak`;
// Astro.url.pathname already includes the configured base at build time.
const canonicalUrl = new URL(canonicalPath, Astro.site);
const ogImageUrl = new URL(url(ogImage), Astro.site);

// The nav is grouped so the top bar stays short: Home stands alone, and the
// rest fall under "The Story" (the campaign as it unfolds) or "The World"
// (the reference atlas of people, places, and powers).
interface NavItem {
  href: string;
  label: string;
  match: string[];
}
interface NavGroup {
  label: string;
  items: NavItem[];
}
const homeItem: NavItem = { href: '/', label: 'Home', match: [] };
const navGroups: NavGroup[] = [
  {
    label: 'The Story',
    items: [
      { href: '/sessions/', label: 'Recaps', match: ['/sessions/'] },
      { href: '/timeline/', label: 'Timeline', match: ['/timeline/'] },
      { href: '/campaign/', label: 'Story so far', match: ['/campaign/'] },
    ],
  },
  {
    label: 'The World',
    items: [
      { href: '/map/', label: 'Map', match: ['/map/'] },
      { href: '/characters/', label: 'Party', match: ['/characters/'] },
      { href: '/npcs/', label: 'NPCs', match: ['/npcs/'] },
      { href: '/graph/', label: 'Relationships', match: ['/graph/'] },
      { href: '/codex/', label: 'Codex', match: ['/codex/', '/factions/', '/lore/'] },
    ],
  },
  {
    label: 'Tools',
    items: [
      { href: '/briefing/', label: 'Next session', match: ['/briefing/'] },
      { href: '/catch-up/', label: 'Catch up', match: ['/catch-up/'] },
      { href: '/table/', label: 'Table reference', match: ['/table/'] },
      { href: '/bookmarks/', label: 'Bookmarks and notes', match: ['/bookmarks/'] },
      { href: '/evidence/', label: 'Evidence', match: ['/evidence/'] },
    ],
  },
];
// Flat list for the footer, where there's room to show every page at once.
const allItems: NavItem[] = [homeItem, ...navGroups.flatMap((g) => g.items)];

const currentPath = Astro.url.pathname;
const isActive = (item: NavItem) =>
  item.href === '/'
    ? currentPath.replace(/\/$/, '') === url('/').replace(/\/$/, '')
    : item.match.some((prefix) => currentPath.startsWith(url(prefix)));
const groupActive = (group: NavGroup) => group.items.some(isActive);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-96.png')} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Dragon of Icespire Peak" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline>
      // Apply saved theme before first paint to avoid a flash. Dark
      // ("Night in the Wilds") is the default; light is "Snowfield".
      try {
        if (localStorage.getItem('icespire-theme') === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      } catch { /* Storage may be unavailable; keep the default theme. */ }
    </script>
  </head>
  <body class:list={{ 'print-document': printable }}>
    <a class="skip-link" href="#main-content" tabindex="0">Skip to content</a>
    <header class="site-header">
      <a class="site-title" href={url('/')}>Dragon of <span class="gold">Icespire Peak</span></a>
      <div class="header-panel" id="site-navigation">
        <nav class="site-nav" aria-label="Primary">
        <a href={url(homeItem.href)} aria-current={isActive(homeItem) ? 'page' : undefined}>
          {homeItem.label}
        </a>
        {
          navGroups.map((group, i) => (
            <div class="nav-group" data-nav-group>
              <button
                type="button"
                class="nav-trigger"
                hidden
                aria-controls={`nav-links-${i}`}
                aria-expanded="false"
                data-current-group={groupActive(group) ? '' : undefined}
              >
                {group.label}
                <span class="nav-caret" aria-hidden="true">▾</span>
              </button>
              <div class="nav-menu" id={`nav-links-${i}`}>
                {group.items.map((item) => (
                  <a
                    href={url(item.href)}
                    tabindex="0"
                    aria-current={isActive(item) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
        </nav>
      </div>
      <div class="header-tools">
        <button class="search-trigger" type="button" data-search-open aria-haspopup="dialog" aria-label="Search or ask" hidden>
          <span class="search-trigger-label">Search<span class="search-trigger-detail"> or ask</span></span>
          <kbd class="search-trigger-key">⌘K</kbd>
        </button>
        <button class="theme-toggle" id="theme-toggle" type="button" hidden>Light mode</button>
        <button class="site-menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" hidden>Menu</button>
      </div>
    </header>
    <main class="page" id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <nav class="footer-nav" aria-label="Footer">
        {allItems.map((item) => <a href={url(item.href)}>{item.label}</a>)}
      </nav>
      A chronicle kept by the party. Updated between sessions.
    </footer>
    {linkEntities && <EntityLinks />}
    <SearchPalette />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById('theme-toggle');
        // The button names the theme it switches TO.
        const label = () =>
          root.getAttribute('data-theme') === 'light' ? 'Dark mode' : 'Light mode';
        button.textContent = label();
        button.hidden = false;
        button.addEventListener('click', () => {
          const toLight = root.getAttribute('data-theme') !== 'light';
          if (toLight) {
            root.setAttribute('data-theme', 'light');
          } else {
            root.removeAttribute('data-theme');
          }
          button.textContent = label();
          try {
            localStorage.setItem('icespire-theme', toLight ? 'light' : 'dark');
          } catch { /* Switching still works for this page without storage. */ }
        });
      })();
    </script>
    <script is:inline>
      // Grouped nav: each "The Story" / "The World" trigger toggles its menu.
      // Click-based (not hover) so it behaves the same for touch, mouse, and
      // keyboard; a click anywhere else, or Escape, closes any open menu.
      (() => {
        const header = document.querySelector('.site-header');
        const panel = header.querySelector('.header-panel');
        const nav = header.querySelector('.site-nav');
        const tools = header.querySelector('.header-tools');
        const menuToggle = header.querySelector('.site-menu-toggle');
        const search = header.querySelector('[data-search-open]');
        const theme = header.querySelector('.theme-toggle');
        const phone = window.matchMedia('(max-width: 900px)');
        let phoneLayout = phone.matches;
        let changingLayout = false;
        let pointerInHeader = false;
        let lastHeaderFocus = null;
        // Touch-generated focus changes can briefly have no related target.
        // Pointer clicks already have explicit inside/outside dismissal; only
        // keyboard focus leaving the header should dismiss it through focusout.
        document.addEventListener('pointerdown', (e) => {
          pointerInHeader = header.contains(e.target);
          if (!pointerInHeader) lastHeaderFocus = null;
        }, true);
        document.addEventListener('keydown', () => { pointerInHeader = false; }, true);
        document.addEventListener('focusin', (e) => {
          if (header.contains(e.target)) lastHeaderFocus = e.target;
          else if (!changingLayout && phone.matches === phoneLayout) lastHeaderFocus = null;
        });
        const groups = Array.from(document.querySelectorAll('[data-nav-group]'));
        const closeAll = (except) => {
          for (const group of groups) {
            if (group === except) continue;
            group.classList.remove('open');
            group.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'false');
          }
        };
        const closeMobile = (restoreFocus = false) => {
          header.classList.remove('menu-open');
          menuToggle.setAttribute('aria-expanded', 'false');
          closeAll(null);
          if (restoreFocus) menuToggle.focus();
        };
        // Keep the DOM in the same order as the visible controls at each size.
        // Desktop: brand, navigation, search, theme. Phone: brand, search, Menu,
        // then its navigation and theme. Without scripts, all links stay visible.
        const layout = () => {
          // A media query may hide a focused control before its change event
          // runs. Retain that control so focus can move to the visible equivalent.
          const active = header.contains(document.activeElement) ? document.activeElement : lastHeaderFocus;
          const focusedPanel = panel.contains(active) || active === theme;
          const focusedMenu = active === menuToggle;
          const groupTrigger = active?.closest?.('[data-nav-group]')?.querySelector('.nav-trigger');
          changingLayout = true;
          closeMobile();
          if (phone.matches) {
            panel.append(theme);
            header.append(panel);
          } else {
            header.insertBefore(panel, tools);
            tools.insertBefore(theme, menuToggle);
          }
          phoneLayout = phone.matches;
          changingLayout = false;
          if (phone.matches && focusedPanel) menuToggle.focus();
          else if (!phone.matches && focusedMenu) header.querySelector('.site-title').focus();
          else if (!phone.matches && focusedPanel) (groupTrigger || active).focus({ preventScroll: true });
        };
        nav.setAttribute('data-nav-ready', '');
        header.setAttribute('data-mobile-nav-ready', '');
        menuToggle.hidden = false;
        search.hidden = false;
        phone.addEventListener('change', layout);
        layout();
        menuToggle.addEventListener('click', (e) => {
          e.stopPropagation();
          if (header.classList.contains('menu-open')) closeMobile(true);
          else {
            header.classList.add('menu-open');
            menuToggle.setAttribute('aria-expanded', 'true');
          }
        });
        header.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape' || !phone.matches || !header.classList.contains('menu-open')) return;
          e.preventDefault();
          e.stopPropagation();
          closeMobile(true);
        });
        header.addEventListener('focusout', (e) => {
          if (changingLayout || phone.matches !== phoneLayout || pointerInHeader) return;
          if (!header.contains(e.relatedTarget)) {
            lastHeaderFocus = null;
            if (phone.matches) closeMobile();
          }
        });
        search.addEventListener('click', () => closeMobile());
        panel.addEventListener('click', (e) => {
          if (phone.matches && e.target.closest('a[href]')) closeMobile();
        });
        for (const group of groups) {
          const trigger = group.querySelector('.nav-trigger');
          if (!trigger) continue;
          trigger.hidden = false;
          trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            const open = group.classList.toggle('open');
            trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
            closeAll(group);
          });
          group.addEventListener('focusout', (e) => {
            if (changingLayout || phone.matches !== phoneLayout || pointerInHeader) return;
            if (!group.contains(e.relatedTarget)) closeAll(null);
          });
          group.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape' || !group.classList.contains('open')) return;
            e.preventDefault();
            e.stopPropagation();
            closeAll(null);
            trigger.focus();
          });
        }
        document.addEventListener('click', (e) => {
          closeAll(null);
          if (phone.matches && !header.contains(e.target)) closeMobile();
        });
      })();
    </script>
  </body>
</html>
