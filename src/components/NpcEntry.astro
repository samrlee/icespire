---
import StatusPill from './StatusPill.astro';
import Portrait from './Portrait.astro';

interface Props {
  name: string;
  role?: string;
  affiliation?: string;
  status?: 'ally' | 'hostile' | 'unresolved' | 'at-large' | 'neutral' | 'deceased';
  note?: string;
  href?: string;
  faction?: string;
  portrait?: string;
}

const { name, role, affiliation, status = 'neutral', note, href, faction, portrait } = Astro.props;
const roleLine = [role, affiliation].filter(Boolean).join(' · ');
---

<li class="npc-entry" data-status={status} data-faction={faction ?? ''}>
  {portrait && <Portrait src={portrait} alt="" class="npc-directory-portrait" width={64} height={80} sizes="64px" maximum={128} />}
  <div class="npc-entry-body">
    <div class="npc-entry-head">
      <div class="npc-name">
        {href ? <a href={href}>{name}</a> : name}
      </div>
      <StatusPill status={status} />
    </div>
    {roleLine && <div class="npc-role">{roleLine}</div>}
    {note && <div class="npc-note">{note}</div>}
  </div>
</li>
