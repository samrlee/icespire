---
// Turns the first mention of any character, NPC, faction, or known location
// inside `.prose` into a link with a hover/tap preview card. The entity data
// is built in lib/entities.ts (shared with the recap cast strip) and emitted
// as JSON here; the DOM work happens in scripts/entity-links.ts.
import { buildEntities } from '../lib/entities';

const entities = await buildEntities();
const json = JSON.stringify(entities).replaceAll('<', '\\u003c');
---

<script is:inline type="application/json" id="entity-link-data" set:html={json} />
<script>
  import '../scripts/entity-links';
</script>
