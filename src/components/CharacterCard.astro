---
interface Props {
  name: string;
  player: string;
  classRace: string;
  portrait?: string;
  bio?: string;
  traits?: string[];
  href?: string;
  variant?: 'roster' | 'page';
}

const { name, player, classRace, portrait, bio, traits = [], href, variant = 'roster' } =
  Astro.props;

// The portrait path lands inside a style attribute, where Astro's HTML escaping
// doesn't help: a ")" in the value would close url() early and let the rest of
// the string become CSS declarations of its own. Quote it and percent-encode
// the quote so the value can only ever be read as one URL.
const portraitCss = portrait
  ? `background-image:url("${encodeURI(portrait).replaceAll('"', '%22')}")`
  : undefined;
---

<article class:list={['card', 'character-card', { page: variant === 'page' }]}>
  <div class="portrait" style={portraitCss}>
    {!portrait && 'Portrait'}
  </div>
  <div class="char-body">
    <div class="char-name">
      {href ? <a href={href}>{name}</a> : name}
    </div>
    <div class="char-class">{classRace}</div>
    <div class="char-player">Played by {player}</div>
    {bio && <p class="char-bio">{bio}</p>}
    {
      traits.length > 0 && (
        <div class="trait-list">
          {traits.map((trait) => (
            <span class="trait">{trait}</span>
          ))}
        </div>
      )
    }
  </div>
</article>
