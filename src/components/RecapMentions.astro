---
import { recapMentions } from '../lib/recap-mentions';
interface Props { href: string }
const recaps = await recapMentions(Astro.props.href);
---
{recaps.length > 0 && (
  <section class="recap-mentions" aria-labelledby="recap-mentions-heading">
    <h2 id="recap-mentions-heading">Mentioned in recaps</h2>
    <ul>
      {recaps.map(recap => (
        <li>
          <a href={recap.href}>Session {recap.number} — {recap.title}</a>
          <span class="recap-mention-date">{recap.date}</span>
          {recap.scenes.length > 0 && <span class="recap-scenes">Mentioned in: {recap.scenes.map(scene => <a href={scene.href}>{scene.label}</a>)}</span>}
        </li>
      ))}
    </ul>
  </section>
)}
