<g class="map-terrain sword-coast" aria-hidden="true">
  <defs>
    <clipPath id="sc-sheet"><rect x="52" y="80" width="1237" height="1713" rx="3" /></clipPath>
    <clipPath id="sc-land"><path d={`${coast} L1289 1793 V80 H79 Z`} /></clipPath>
    <pattern id="sc-trees" width="49" height="43" patternUnits="userSpaceOnUse">
      <g class="sc-tree">{[[8,9,1],[29,5,.8],[45,18,1.1],[23,25,1],[4,37,.75],[39,40,.8]].map(([x,y,s])=><path d={treeMark} transform={`translate(${x} ${y}) scale(${s})`} />)}</g>
    </pattern>
    <pattern id="sc-scrub" width="113" height="97" patternUnits="userSpaceOnUse">
      <g class="sc-scrub"><path d="M13 19 l4 -3 m3 7 l6 -2 M75 61 l3 -3 m3 5 l5 -1 M52 84 l3 -4 m2 6 l6 -2" /></g>
    </pattern>
  </defs>
  <rect class="m-land" width="1344" height="1872" />
  <g clip-path="url(#sc-sheet)">
    <path class="m-sea" d={`${coast} L52 1793 V80 H79 Z`} />
    <g class="sc-offshore"><path d={coast} transform="translate(-18 0)" /><path d={coast} transform="translate(-36 0)" /><path d={coast} transform="translate(-57 0)" /></g>
    <path class="sc-hex" d={hexes.join(' ')} />
    <rect width="1344" height="1872" fill="url(#sc-scrub)" clip-path="url(#sc-land)" />
    <g class="sc-forest">{forests.map(d=><path d={d} />)}</g>
    {forests.map(d=><path fill="url(#sc-trees)" d={d} />)}
    <g class="sc-hill">{hills.flatMap(([x,y,rx,ry],i)=>hillRidges(x,y,rx,ry,i)).map(d=><path d={d} />)}</g>
    <g class="sc-mountains">{peaks.map(([x,y,w,h],i)=><g transform={`translate(${x} ${y})`}>
      <path class="sc-mountain-face" d={`M${-w} 13 L${-w*.73} ${-h*.36} ${-w*.45} ${-h*.5} ${-w*.16} ${-h} ${w*.12} ${-h*.9} ${w*.34} ${-h*.33} ${w*.64} ${-h*.12} ${w} 16 Q0 ${h*.48} ${-w} 13 Z`} />
      <path class="sc-crest" d={`M${-w*.73} ${-h*.36} L${-w*.45} ${-h*.5} ${-w*.16} ${-h} ${w*.12} ${-h*.9} ${w*.34} ${-h*.33} ${w*.64} ${-h*.12}`} />
      <g class="sc-ridges">{Array.from({length:15},(_,n)=>{
        const t=n/14,xx=-w+w*2*t, yy=-h*(.28+.65*Math.sin(t*Math.PI)), drift=Math.sin(n+i)*7;
        return <path d={`M${xx*.64} ${yy} Q${xx*.8+drift} ${yy*.3} ${xx} ${10+Math.sin(n*3)*5}`} />;
      })}</g>
    </g>)}</g>
    <g class="sc-river-bank">{rivers.map(d=><path d={d} />)}</g>
    <g class="sc-river">{rivers.map(d=><path d={d} />)}</g>
    <path class="sc-shore" d={coast} />
    <g class="sc-road">{roads.map(d=><path d={d} />)}</g>
    <g class="sc-trail">{trails.map(d=><path d={d} />)}</g>
    <g class="sc-marsh">{Array.from({length:42},(_,i)=>{
      const x=480+(i%9)*29+Math.sin(i*3)*9,y=1685+Math.floor(i/9)*25+Math.cos(i)*8;
      return <path d="M-7 0 L-3 -5 M0 0 V-7 M7 0 L4 -5 M-11 4 H11" transform={`translate(${x} ${y})`} />;
    })}</g>
  </g>
  <rect class="sc-border" x="43" y="68" width="1258" height="1739" rx="4" />
  <g class="sc-title"><text x="100" y="171">Sword Coast</text><text class="sc-subtitle" x="103" y="203">THE PARTY’S CHART · 1 HEX = 5 MILES</text></g>
  <g class="m-compass" transform="translate(1163 198) scale(2)"><circle r="22" /><line x1="0" y1="16" x2="0" y2="-12" /><path class="m-compass-arrow" d="M0 -20 L6 -6 L0 -10 L-6 -6 Z" /><text y="-30">N</text></g>
  <g class="sc-scale" transform="translate(108 1734)"><path d="M0 -6 V6 M0 0 H242.5 M121.25 -6 V6 M242.5 -6 V6" /><text x="0" y="28">0</text><text x="121.25" y="28">10</text><text x="242.5" y="28">20 miles</text></g>
</g>
