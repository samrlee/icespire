---
// Local map of Umbrage Hill, traced feature-by-feature against the official
// map (offical-assets/Maps/map-13.02-umbrage-hill.jpg, 2888 × 1838 —
// reference only, never shipped; the map-13.01 player variant is not a
// source). Uniform mapping: my = official_px × 0.31163 (900/2888), no
// offset; viewBox 900 × 573; north is up.
// Official grid: 1 square = 5 feet ≈ 11.4 units, so 50 feet ≈ 114 units.

// The post fence ringing the hilltop yard, as [x, y] vertices running
// clockwise from the north gate gap (posts drawn at each vertex).
const fence: [number, number][] = [
  [319, 286], [352, 292], [377, 305], [401, 323], [421, 338], [434, 352],
  [450, 368], [458, 380], [464, 394], [467, 405], [464, 418], [458, 433],
  [449, 446], [433, 458], [413, 467], [390, 477], [368, 487], [343, 492],
  [319, 495], [296, 492], [282, 487], [262, 474], [246, 462], [232, 446],
  [222, 425], [217, 405], [213, 391], [213, 374], [215, 358], [219, 343],
  [225, 330], [234, 318], [246, 309], [259, 299], [270, 290], [287, 285],
  [301, 283],
];

// Boulder clusters in the southeast field (U1) as [x, y].
const boulders: [number, number][] = [
  [538, 511], [589, 485], [648, 469], [698, 491], [660, 526], [732, 516],
  [566, 552],
];

// Grass tufts, kept clear of the inset panel.
const grass: [number, number][] = [
  [120, 90], [240, 150], [360, 80], [90, 230], [140, 380], [100, 480],
  [340, 200], [460, 300], [420, 480], [300, 540], [520, 350], [590, 320],
  [700, 300], [820, 360], [780, 470], [640, 240], [560, 210], [850, 260],
];
---

<g class="submap-umbrage" aria-hidden="true">
  <rect class="sm-ground" x="0" y="0" width="900" height="573"></rect>

  <!-- Contours. The +0 line runs from the east edge around the whole
       western hill and off the south edge; +10 through +40 climb the
       southeast rise around the boulder field. -->
  <g class="sm-contour">
    <path d="M 900 193 C 878 207 838 228 816 236 C 796 242 785 244 773 242 C 752 239 733 233 717 228 C 696 221 671 210 654 206 C 638 202 620 201 608 203 C 588 206 565 208 545 213 C 528 218 510 222 499 228 C 493 219 483 207 474 199 C 467 187 458 172 449 162 C 437 150 420 140 405 134 C 389 128 369 124 352 123 C 334 122 314 122 296 123 C 259 125 222 128 187 134 C 159 139 133 148 109 159 C 91 168 75 181 62 196 C 52 211 48 232 45 249 C 41 268 40 286 39 305 C 38 324 40 343 42 362 C 44 383 48 404 53 424 C 58 442 64 461 73 477 C 81 492 93 505 106 517 C 119 529 135 540 153 549 C 169 557 187 561 206 563 C 226 565 247 566 268 566 C 289 566 310 564 330 561 C 349 559 368 566 383 573"></path>
    <path d="M 424 296 Q 428 306 433 314 C 453 310 486 319 514 319 C 540 318 566 306 592 295 C 613 288 636 284 656 284 C 682 285 709 294 734 307 C 761 322 788 338 812 356 C 836 374 862 393 879 406 Q 889 412 900 418"></path>
    <path d="M 900 508 C 886 496 869 481 857 471 C 837 453 815 429 795 413 C 771 393 745 372 719 361 C 695 350 670 342 648 341 C 626 341 603 346 583 354 C 556 364 528 375 505 385 C 483 396 458 407 442 415 Q 439 419 438 424"></path>
    <path d="M 439 573 Q 444 552 452 534 C 458 519 467 505 476 492 C 487 476 500 462 516 450 C 534 435 557 422 578 413 C 595 406 615 400 633 400 C 652 400 672 404 690 411 C 712 420 734 435 752 451 C 772 470 791 488 805 506 C 817 522 827 536 833 550 Q 840 561 842 573"></path>
    <path d="M 486 573 Q 491 553 499 535 C 505 520 514 506 524 492 C 534 479 548 472 563 464 C 577 457 596 448 612 447 C 632 446 654 448 671 455 C 689 463 705 471 718 483 C 731 496 742 508 749 522 C 756 535 762 549 764 562 Q 766 568 767 573"></path>
    <!-- Rings around the windmill knoll -->
    <path d="M 327 182 C 360 184 394 192 421 203 C 446 214 466 230 483 249 C 497 265 507 292 514 312 C 519 332 520 353 520 374 C 520 397 513 421 505 443 C 495 469 480 492 461 511 C 442 530 417 543 390 552 C 365 560 338 562 312 561 C 286 560 258 560 234 552 C 207 543 182 536 162 520 C 141 503 127 490 115 467 C 103 445 96 430 92 405 C 88 384 88 364 90 343 C 92 321 97 299 106 280 C 115 261 126 245 140 231 C 153 218 169 207 187 199 C 206 191 227 185 249 184 C 274 182 301 181 327 182 Z"></path>
    <path d="M 315 217 C 341 219 366 224 390 232 C 411 240 430 252 446 268 C 461 283 474 297 483 315 C 491 331 493 350 495 368 C 497 387 493 406 486 424 C 478 445 466 464 449 480 C 433 495 412 509 390 520 C 368 530 343 534 318 536 C 294 537 269 536 246 527 C 226 519 202 511 187 495 C 172 479 162 465 156 446 C 150 428 147 411 147 393 C 147 375 149 357 153 340 C 158 322 165 305 175 290 C 186 275 199 260 215 249 C 231 238 249 229 268 224 C 283 220 299 216 315 217 Z"></path>
    <path d="M 312 258 C 333 259 354 263 374 270 C 393 277 410 287 424 299 C 437 311 448 325 458 340 C 468 356 477 372 480 390 C 483 408 480 427 474 443 C 467 461 456 474 443 486 C 428 499 411 505 393 511 C 374 516 353 518 333 517 C 313 516 292 515 274 508 C 257 501 240 493 227 480 C 216 468 208 452 203 436 C 198 421 196 405 196 390 C 196 375 198 358 203 343 C 208 328 214 313 224 302 C 234 290 247 281 262 273 C 277 266 294 258 312 258 Z"></path>
  </g>
  <text class="sm-note" x="680" y="225">+0 ft.</text>
  <text class="sm-note" x="674" y="270">+10 ft.</text>
  <text class="sm-note" x="665" y="324">+20 ft.</text>
  <text class="sm-note" x="653" y="380">+30 ft.</text>
  <text class="sm-note" x="625" y="429">+40 ft.</text>

  <!-- Grass tufts -->
  <g class="sm-grass">
    {grass.map(([x, y]) => (
      <path d="M-5 0 L-3 -6 M0 0 L0 -7 M5 0 L3 -6" transform={`translate(${x} ${y})`} />
    ))}
  </g>

  <!-- The post fence around the yard, gate gap north -->
  <polyline class="sm-fence" points={fence.map(([x, y]) => `${x},${y}`).join(' ')}></polyline>
  <g class="sm-detail-fill">
    {fence.map(([x, y]) => (
      <circle cx={x} cy={y} r="1.5" />
    ))}
  </g>

  <!-- The windmill (U3): walled yard, upper-floor overhang, mill machinery -->
  <rect class="sm-floor" x="269.5" y="336.5" width="78" height="78" rx="2" style="stroke-width: 5;"></rect>
  <rect class="sm-crack" x="285" y="352" width="47" height="47"></rect>
  <g class="sm-detail">
    <circle cx="304" cy="378.5" r="21.5"></circle>
    <circle cx="304" cy="378.5" r="12.5"></circle>
    {Array.from({ length: 8 }, (_, i) => {
      const a = (i * Math.PI) / 4;
      return (
        <line
          x1={304 + Math.cos(a) * 12.5}
          y1={378.5 + Math.sin(a) * 12.5}
          x2={304 + Math.cos(a) * 16.5}
          y2={378.5 + Math.sin(a) * 16.5}
        />
      );
    })}
  </g>
  <circle class="sm-detail-fill" cx="304" cy="378.5" r="3"></circle>
  <!-- Window slits on the yard walls -->
  <g class="sm-detail-fill">
    {[
      [288, 339, 0], [322, 339, 0], [288, 412, 180], [322, 412, 180],
      [272, 361, 270], [272, 394, 270], [345, 361, 90], [345, 394, 90],
    ].map(([x, y, r]) => (
      <path d="M-3.2 0 L3.2 0 L0 4.5 Z" transform={`translate(${x} ${y}) rotate(${r})`} />
    ))}
  </g>
  <!-- Yard door, east wall near the ruin -->
  <rect class="sm-door" x="344.5" y="400" width="4.5" height="9"></rect>
  <!-- Debris on the yard floor, southeast corner -->
  <g class="sm-detail">
    <path d="M 325 400 l 6 3 M 328 405 l 5 -2 M 330 358 l 6 1.5 M 333 356 l 0 5"></path>
  </g>

  <!-- The ruined outbuilding (U2): stone shell and broken garden walls -->
  <rect class="sm-rock" x="370" y="364" width="22" height="21" rx="2"></rect>
  <rect class="sm-detail-fill" x="377" y="380" width="7" height="5"></rect>
  <g class="sm-crack" style="stroke-width: 2.2;">
    <path d="M 409 372 L 409 388"></path>
    <path d="M 409 396 l 0 14 l -9 0"></path>
    <path d="M 405 428 l 0 12 l -10 0"></path>
    <path d="M 350 400 C 355 404 360 406 364 408 L 357 412 L 357 428"></path>
    <path d="M 357 432 L 357 446"></path>
    <path d="M 357 456 l 20 1"></path>
    <path d="M 381 457 l 18 0.5"></path>
  </g>
  <g class="sm-detail">
    <circle cx="394" cy="361" r="2.2"></circle>
    <circle cx="366" cy="376" r="2"></circle>
    <circle cx="409" cy="392" r="1.8"></circle>
    <circle cx="357" cy="450" r="1.8"></circle>
    <circle cx="404" cy="457" r="1.8"></circle>
  </g>

  <!-- The boulder field (U1) -->
  <g>
    {boulders.map(([x, y]) => (
      <g class="sm-rock">
        <circle cx={x} cy={y} r="6" />
        <circle cx={x + 8} cy={y + 4} r="4.5" />
        <circle cx={x - 6} cy={y + 6} r="3.6" />
        <circle cx={x + 2} cy={y + 8} r="3" />
      </g>
    ))}
  </g>

  <!-- Inset: the windmill's upper floors, as on the official sheet -->
  <g>
    <rect class="sm-inset" x="491" y="27" width="352" height="163" rx="2"></rect>
    <rect class="sm-inset" x="497" y="33" width="340" height="151" rx="1" style="fill: none; stroke-width: 0.75; opacity: 0.7;"></rect>

    <!-- Second floor -->
    <rect class="sm-inner" x="536" y="82" width="72" height="68" rx="6"></rect>
    <rect class="sm-floor" x="542.5" y="88.5" width="55" height="55" rx="1" style="stroke-width: 4;"></rect>
    <g class="sm-detail-fill">
      <rect x="542.5" y="88.5" width="13" height="13"></rect>
      <rect x="584.5" y="88.5" width="13" height="13"></rect>
      <rect x="542.5" y="130.5" width="13" height="13"></rect>
      <rect x="584.5" y="130.5" width="13" height="13"></rect>
    </g>
    <circle class="sm-detail" cx="570" cy="116" r="6"></circle>
    <circle class="sm-detail-fill" cx="570" cy="116" r="1.6"></circle>
    <rect class="sm-door" x="564" y="86.5" width="12" height="3.5"></rect>
    <rect class="sm-door" x="595.5" y="111" width="3.5" height="10"></rect>
    <rect class="sm-inner" x="599" y="107" width="10" height="17"></rect>
    <g class="sm-stairs">
      <path d="M 564 133 h 12 M 564 136.5 h 12 M 564 140 h 12 M 564 143.5 h 12"></path>
    </g>
    <text class="sm-label" x="567" y="160" text-anchor="middle" style="font-size: 10.5px;">Second floor</text>
    <text class="sm-label" x="567" y="172" text-anchor="middle" style="font-size: 10.5px;">of windmill</text>

    <!-- Third floor -->
    <line class="sm-detail" x1="681" y1="55" x2="681" y2="168" style="stroke-width: 2.2;"></line>
    <rect class="sm-floor" x="691" y="88" width="58" height="55" rx="1" style="stroke-width: 4;"></rect>
    <rect class="sm-inner" x="751" y="94" width="20" height="46"></rect>
    <g class="sm-detail" style="opacity: 0.6;">
      <path d="M 751 105 h 20 M 751 117 h 20 M 751 129 h 20 M 761 94 v 46"></path>
    </g>
    <line class="sm-detail" x1="682" y1="110" x2="702" y2="110" style="stroke-width: 3;"></line>
    <circle class="sm-detail-fill" cx="704" cy="110" r="6"></circle>
    <text class="sm-label" x="718" y="160" text-anchor="middle" style="font-size: 10.5px;">Third floor</text>
    <text class="sm-label" x="718" y="172" text-anchor="middle" style="font-size: 10.5px;">of windmill</text>
  </g>

  <!-- Numbered points of interest -->
  <g class="sm-poi" data-tip-title="Adabra Gwynn's windmill" data-tip-sub="The potions brew here and nowhere else">
    <circle cx="282" cy="393" r="8"></circle><text x="282" y="393">1</text>
  </g>
  <g class="sm-poi" data-tip-title="Ruined outbuilding" data-tip-sub="Old garden walls; good cover in the fight">
    <circle cx="376" cy="407" r="8"></circle><text x="376" y="407">2</text>
  </g>
  <g class="sm-poi danger" data-tip-title="The boulder field" data-tip-sub="Manticore country">
    <circle cx="614" cy="517" r="8"></circle><text x="614" y="517">3</text>
  </g>

  <!-- Scale: the official grid is 1 square = 5 feet -->
  <g class="sm-scale" transform="translate(36 546)">
    <line x1="0" y1="0" x2="114" y2="0"></line>
    <line x1="0" y1="-4" x2="0" y2="4"></line>
    <line x1="114" y1="-4" x2="114" y2="4"></line>
    <text x="57" y="-8">≈ 50 feet</text>
  </g>

  <!-- Compass, bottom-left as on the official sheet -->
  <g class="m-compass" transform="translate(69 491)">
    <circle r="18"></circle>
    <line x1="0" y1="13" x2="0" y2="-9"></line>
    <path class="m-compass-arrow" d="M0 -16 L5 -5 L0 -8 L-5 -5 Z"></path>
    <text y="-25">N</text>
  </g>
</g>
