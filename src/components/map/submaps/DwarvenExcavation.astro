---
// Traced in a 1960 × 1248 coordinate space from the official reference scan.
// The scan's grid is 29.4 units = 5 feet. Keep geometry in this coordinate
// space: resizing individual rooms destroys the shared scale and alignment.
// The scan itself stays in offical-assets and is never included in the build.
interface Props { interior?: boolean }
const { interior = false } = Astro.props;

// Matched inner/outer cliff stations, southwest approach clockwise to temple.
const northRim = [
  [20,738,20,634], [90,775,88,661], [180,776,171,690],
  [268,749,268,681], [322,699,336,629], [365,586,349,536],
  [377,510,349,450], [396,471,350,406], [440,430,265,361],
  [429,391,262,319], [451,369,283,263], [479,355,370,207],
  [503,373,441,225], [540,369,502,244], [567,392,559,245],
  [591,430,643,308], [610,477,677,380], [646,526,673,443],
  [688,547,697,486], [733,540,743,489], [775,522,794,495],
  [834,528,834,508],
];
const southRim = [
  [20,1225,105,1214], [61,1138,140,1146], [103,1070,192,1109],
  [184,1036,268,1108], [244,999,364,1109], [325,979,443,1074],
  [350,948,472,1017], [352,908,490,951], [399,844,569,925],
  [451,794,653,927], [485,744,705,900], [504,662,773,911],
  [535,649,822,884], [574,684,795,817], [626,698,801,765],
  [674,730,845,748], [737,749,891,740], [792,744,891,720],
];
function ridgeTicks(stations: number[][]) {
  return stations.slice(1).flatMap((b, i) => {
    const a = stations[i];
    const count = Math.max(2, Math.ceil(Math.hypot(b[0]-a[0], b[1]-a[1]) / 13));
    return Array.from({ length: count }, (_, j) => {
      const t = j / count;
      const [x,y,u,v] = a.map((n,k) => n + (b[k]-n)*t);
      const bend = Math.sin(i * 4 + j * 2) * 5;
      return `M${x} ${y} Q${(x+u)/2+bend} ${(y+v)/2-bend} ${u} ${v}`;
    });
  });
}
const canyon = 'M20 738 L58 758 90 775 139 780 180 776 228 765 268 749 302 724 322 699 346 659 357 619 365 586 369 549 377 510 386 487 396 471 417 458 433 442 440 430 437 412 429 399 429 391 436 380 451 369 467 364 479 355 493 359 503 373 519 377 540 369 554 378 567 392 576 409 591 430 599 452 610 477 622 496 646 526 663 531 676 545 688 547 711 543 733 540 750 527 775 522 804 524 834 528 L891 528 891 722 858 722 829 729 811 737 792 744 764 754 737 749 707 744 674 730 649 720 626 698 601 694 574 684 558 661 546 650 535 649 520 660 504 662 499 705 485 744 468 773 451 794 423 823 399 844 374 875 352 908 347 929 350 948 343 966 325 979 283 992 244 999 216 1014 184 1036 144 1045 118 1053 103 1070 93 1098 76 1121 61 1138 53 1161 35 1192 20 1225 Z';
const cliffOutline = 'M20 634 L88 661 171 690 222 695 268 681 306 660 336 629 349 536 349 450 350 406 311 392 265 361 258 341 262 319 274 280 283 263 321 241 340 216 370 207 397 211 441 225 477 235 502 244 537 240 559 245 589 267 618 275 643 308 645 333 661 356 677 380 666 410 673 443 684 478 697 486 743 489 794 495 834 508 L891 508 891 740 845 748 811 778 795 817 806 854 822 870 814 898 773 911 735 906 705 900 677 915 653 927 610 924 569 925 529 934 490 951 473 975 472 1017 464 1047 443 1074 404 1094 364 1109 316 1112 268 1108 229 1101 192 1109 166 1122 140 1146 131 1175 105 1214 81 1228 20 1225 Z';

// Floor footprints share the official grid, including the five-foot galleries.
const floors = [
  'M891 596 H1044 V537 H1074 V508 H1189 V566 H1219 L1248 595 V653 L1219 683 H1189 V742 H1074 V712 H1044 V654 H891 Z',
  'M984 596 V564 H955 V478 H1029 L1054 452 Q1062 444 1062 458 L1059 471 1065 481 1044 504 H1010 V596 Z',
  'M1133 508 V445 H1118 Q1100 445 1103 428 Q1105 419 1118 419 H1281 V445 H1160 V508 Z',
  'M1281 389 H1366 V505 H1310 L1281 477 Z',
  'M1189 508 H1262 L1307 552 V670 L1294 693 1279 700 1263 741 H1189 V715 H1250 L1281 681 V563 L1250 533 H1189 Z',
  'M985 654 H1010 V713 L1102 805 H1281 V831 H1087 L985 729 Z',
  'M1133 742 H1160 V805 H1133 Z',
  'M1281 831 V779 Q1284 752 1301 764 L1312 781 1332 790 1353 793 Q1367 797 1366 814 V860 H1281 Z',
  'M1341 508 H1396 V610 H1369 V595 L1341 566 Z',
  'M1307 612 H1442 Q1459 610 1459 626 L1454 635 H1307 Z',
  'M1369 640 H1396 V709 L1390 733 1379 731 1367 710 1342 699 V684 L1369 656 Z',
  'M1517 613 V596 L1547 567 H1564 L1578 538 H1606 L1621 567 H1634 L1663 596 V654 L1634 684 H1620 L1606 713 H1578 L1564 684 H1547 L1517 654 V635 H1504 L1491 627 1498 615 Z',
];
const ruins = [
 'M478 387 V446 H526', 'M505 364 V418', 'M565 389 V447 H554',
 'M390 477 H447 V497', 'M389 535 V566 H404', 'M447 530 V566',
 'M417 569 V595 H447', 'M506 585 V552 H534', 'M591 480 L566 506 591 530',
 'M639 521 L617 540', 'M653 535 V565 H684 V546', 'M550 568 L571 590 H598 V601',
 'M594 620 V627 H578', 'M505 625 V650 L518 662', 'M623 678 V654 H632',
 'M651 653 H679 V674', 'M684 700 V731',
];
const rubblePiles = [[790,575,25],[834,625,25],[791,677,25],[984,514,23],[1039,482,13],[1115,431,11],[1259,725,15],[1291,684,13],[1295,779,11],[1357,808,12],[1382,711,13],[1446,624,11],[1504,625,10],[1592,696,20]];
const pebbles = rubblePiles.flatMap(([x,y,r],p) => Array.from({length: 22},(_,i) => {
  const angle = i * 2.39996 + p;
  const radius = Math.sqrt((i+.5)/22) * r;
  return { x:x+Math.cos(angle)*radius, y:y+Math.sin(angle)*radius, r:2+(i*7%5) };
}));
const pois = [
 {x:306,y:833,n:1,title:"The dwarves' camp",note:'Stripped bare and abandoned in Session 6'},
 {x:506,y:506,n:2,title:'Buried settlement',note:"Ruins under Abbathor's avalanche"},
 {x:777,y:625,n:3,title:'The broken gate',note:'Black stone, long since shattered'},
 {x:977,y:625,n:4,title:'Entrance hall',note:'The funnel where the party fought seven orcs'},
 {x:1131,y:625,n:5,title:'Main chamber',note:'Four pillars and the altar; the jelly fight'},
 {x:1233,y:521,n:6,title:'Rubble hallway',note:'The passage around the main chamber'},
 {x:1309,y:834,n:7,title:'South passage',note:'The dead dwarf and the temple ledger'},
 {x:1323,y:448,n:8,title:'The crypt',note:"A skeleton wearing Abbathor's holy symbol"},
 {x:1368,y:551,n:9,title:'The vestry',note:'Two dwarves in red vestments; a dry stone font'},
 {x:1375,y:683,n:10,title:'Sleeping chamber',note:'Three bed frames and a longsword that never rotted'},
 {x:1424,y:624,n:11,title:'The cave-in',note:'The party burrowed through in Session 7'},
 {x:1592,y:624,n:12,title:'The hidden chamber',note:'Two shattered statues; the last offering taken in Session 7'},
];
---

<g class="submap-excavation" aria-hidden="true">
  <defs>
    <pattern id="exc-grid" width="29.4" height="29.4" x="15" y="7" patternUnits="userSpaceOnUse">
      <path d="M29.4 0 H0 V29.4" class="exc-grid-line" />
    </pattern>
    <clipPath id="exc-cliffs"><path d={cliffOutline} /></clipPath>
    <clipPath id="exc-floors">
      <path d={canyon} />
      {interior && floors.map(d => <path d={d} />)}
    </clipPath>
  </defs>
  <rect class="sm-ground" width="1960" height="1248" />
  <path class="exc-cliff-face" d={cliffOutline} />
  <g class="exc-hachures" clip-path="url(#exc-cliffs)">{[...ridgeTicks(northRim),...ridgeTicks(southRim)].map(d => <path d={d} />)}</g>
  <path class="exc-canyon" d={canyon} />
  {interior && <g class="exc-rooms">{floors.map(d => <path d={d} />)}</g>}
  <rect width="1960" height="1248" fill="url(#exc-grid)" clip-path="url(#exc-floors)" />

  <g class="exc-ruins">{ruins.map(d => <path d={d} />)}</g>
  <g class="exc-gates">
    <path d="M347 624 L389 649 M452 692 L503 724" />
    <path d="M748 525 L745 593 M746 648 L745 750" />
  </g>
  <circle class="exc-ruined-well" cx="640" cy="610" r="14" />
  <g class="exc-steps">
    <path d="M891 509 H832 V742 H891 M891 526 H841 V724 H891 M891 538 H850 V712 H891 M891 548 H860 V702 H891" />
  </g>
  <g class="exc-rubble">{pebbles.filter(p => interior || p.x < 900).map(p => <path d={`M${p.x-p.r} ${p.y} l${p.r*.6} ${-p.r} ${p.r*1.2} ${p.r*.2} ${p.r*.4} ${p.r} ${-p.r} ${p.r*.8} Z`} />)}</g>

  {interior && <>
    <g class="exc-openings"><path d="M990 596 H1004 M1307 615 V632" /></g>
    <g class="exc-pillars">
      <circle cx="1085" cy="580" r="12" /><circle cx="1145" cy="580" r="11" />
      <circle cx="1085" cy="669" r="12" /><circle cx="1145" cy="669" r="12" />
      <rect x="1210" y="608" width="20" height="35" />
      <path d="M1218 615 h4 M1218 634 h4" />
    </g>
    <g class="exc-statues">
      {[567,684].map(y => <g transform={`translate(893 ${y})`}><circle r="10" /><path d="M0 -7 L2 -2 7 -2 3 2 4 7 0 4 -4 7 -3 2 -7 -2 -2 -2 Z" /></g>)}
    </g>
    <g class="exc-doors">
      <path d="M919 606 l26 -4 M919 643 l26 5 M1014 608 l24 -4 M1014 643 l24 5" />
      <path d="M1281 425 v13 M1281 811 v13 M1140 805 h13 M1376 610 h13 M1376 640 h13 M1517 618 v13" />
    </g>
    <g class="exc-found-doors">
      <path d="M1138 508 h15 M1189 513 v15 M1138 742 h15 M1189 720 v15 M1344 505 h15 M1307 619 v13 M990 654 h14" />
    </g>
  </>}

  {pois.filter(p => interior || p.n <= 3).map(p => <g class="sm-poi exc-poi" data-tip-title={p.title} data-tip-sub={p.note}>
    <circle cx={p.x} cy={p.y} r="17" /><text x={p.x} y={p.y}>{p.n}</text>
  </g>)}
  <g class="exc-map-title">
    <text x="272" y="133">Dwarven Excavation</text>
    <text class="exc-subtitle" x="275" y="166">THE TEMPLE OF ABBATHOR</text>
  </g>
  <g class="exc-scale" transform="translate(1450 931)">
    <text x="147" y="-23">1 square = 5 feet</text>
    <path d="M0 -6 V6 M0 0 H294 M147 -6 V6 M294 -6 V6" />
    <text x="0" y="29">0</text><text x="147" y="29">25</text><text x="294" y="29">50 ft</text>
  </g>
  <g class="m-compass" transform="translate(1654 1073) scale(2)">
    <circle r="18" /><line x1="0" y1="13" x2="0" y2="-9" />
    <path class="m-compass-arrow" d="M0 -16 L5 -5 L0 -8 L-5 -5 Z" /><text y="-25">N</text>
  </g>
</g>
