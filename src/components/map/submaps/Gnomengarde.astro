---
<g class="submap-gnomengarde ref-map" aria-hidden="true">
  <defs>
    <pattern id="gn-grid" width="29.4" height="29.4" x="31" y="30" patternUnits="userSpaceOnUse"><path class="ref-grid" d="M29.4 0 H0 V29.4" /></pattern>
    <clipPath id="gn-rocks"><path d={westRock} /><path d={eastRock} /></clipPath>
    <clipPath id="gn-water"><path d={river} /></clipPath>
  </defs>
  <rect class="sm-ground" width="1960" height="1248" />
  <rect width="1960" height="1248" fill="url(#gn-grid)" />
  <g class="gn-rock"><path d={westRock} /><path d={eastRock} /></g>
  <g class="gn-rock-edge"><path d={westRock.split(" 1940 1248")[0]} /><path d={eastRock.split(" L20 1248")[0]} /></g>
  <g class="gn-cliff" clip-path="url(#gn-rocks)">{ridges.flatMap((r,i)=>cliffLines(r,i<2?1:-1)).map(d => <path d={d} />)}</g>
  <path class="gn-water" d={river} />
  <g class="gn-ripples" clip-path="url(#gn-water)">
    <path d="M1196 24 Q1190 83 1101 129 Q973 190 1008 313 Q1024 372 1101 414 M1011 752 Q997 818 1041 850 M1099 891 Q1158 910 1174 1018 M1279 891 Q1259 926 1287 965" />
    {Array.from({length:22},(_,i) => <path d={`M${1125+i*7} ${1057+Math.sin(i)*5} q7 12 14 42`} />)}
  </g>
  {islands.map(d => <path class="gn-island" d={d} />)}
  <g class="gn-mushrooms">{[[1128,685,25,47],[1222,850,18,30]].flatMap(([x,y,w,h])=>Array.from({length:24},(_,i)=>{
    const a=i*2.4, r=Math.sqrt((i+.5)/24), px=x+Math.cos(a)*r*w, py=y+Math.sin(a)*r*h;
    return <g transform={`translate(${px} ${py})`}><circle r="5.5" /><path d="M0 0 v4 M-2 -2 h1" /></g>;
  }))}</g>

  {interior && <>
    <g class="gn-room-walls">{rooms.map(d=><path d={d} />)}</g>
    <g class="gn-corridor-walls">{corridors.map(d=><path d={d} />)}</g>
    <g class="gn-room-floors">{rooms.map(d=><path d={d} />)}</g>
    <g class="gn-corridor-floors">{corridors.map(d=><path d={d} />)}</g>
    <g class="gn-room-grid">{rooms.map(d=><path d={d} />)}</g>
    <g class="gn-corridor-grid">{corridors.map(d=><path d={d} />)}</g>
    <g class="gn-steps">{steps.map(([x,y,r,n])=><g transform={`translate(${x} ${y}) rotate(${r})`}>{Array.from({length:n},(_,i)=><path d={`M-10 ${i*7} q10 -4 20 0`} />)}</g>)}</g>
    <g class="gn-furniture">
      <path d="M255 763 H340 V817 H255 Z M262 770 H333 V810 H262 Z M268 777 H327 V804 H268 Z" />
      <path d="M276 783 H293 V797 H276 Z M304 783 H321 V797 H304 Z" />
      <g transform="translate(1502 609)"><circle r="15" /><path d="M-24 0 H24 M0 -24 V24 M-20 -10 Q0 -26 20 -10 M-20 10 Q0 26 20 10 M-9 -9 L9 9 M9 -9 L-9 9" /></g>
      {[997,1087].map((y,i)=><g transform={`translate(938 ${y}) rotate(${i*40})`}><circle r="5" /><path d="M0 0 Q-27 -18 -41 -9 Q-14 1 0 0 Q18 -27 9 -41 Q-1 -14 0 0 Q27 18 41 9 Q14 -1 0 0 Q-18 27 -9 41 Q1 14 0 0" /></g>)}
      {[[1696,330],[1784,446]].map(([x,y])=><g transform={`translate(${x} ${y}) rotate(-40)`}><rect x="-11" y="-16" width="22" height="32" rx="7" /><path d="M-11 -7 L-22 -13 M-11 7 L-22 13 M11 -7 L22 -13 M11 7 L22 13 M-7 -7 H7 V7 H-7 Z" /></g>)}
      {barrels.map(([x,y])=><g transform={`translate(${x} ${y})`}><rect x="-7" y="-11" width="14" height="22" rx="5" /><path d="M-7 -5 H7 M-7 5 H7 M-2 -11 V11 M2 -11 V11" /></g>)}
    </g>
    <g class="gn-doors"><path d="M283 922 H315 M424 714 H439 M426 1042 H440 M536 869 V883 M1487 217 V232" /></g>
    <g class="gn-secret-doors"><path d="M335 654 H353 M335 742 H353" /></g>
  </>}
  <g class="gn-bridge">
    <path d="M1098 951 Q1205 964 1313 951 L1318 988 Q1206 976 1098 985 Z" />
    {Array.from({length:24},(_,i)=><path d={`M${1103+i*9} ${953+Math.sin(i/24*Math.PI)*6} v27`} />)}
    <path d="M1098 947 L1110 982 1121 950 1132 985 1143 953 1154 986 1165 955 1176 986 1187 955 1198 985 1209 955 1220 985 1231 954 1242 985 1253 953 1264 985 1275 953 1286 986 1297 951 1318 989" />
  </g>
  {markers.filter(m=>interior||m[2]<=2).map(([x,y,n,title,note])=><g class="sm-poi ref-poi" data-tip-title={title} data-tip-sub={note}><circle cx={x} cy={y} r="17" /><text x={x} y={y}>{n}</text></g>)}
  <g class="ref-elevation">{[[1325,522,30],[899,670,30],[1350,757,20],[1319,935,20],[1127,1016,20],[566,877,10],[1488,1021,10]].map(([x,y,h])=><text x={x} y={y}>+{h} ft.</text>)}</g>
  <text class="ref-title" x="108" y="135">Gnomengarde</text>
  <text class="ref-subtitle" x="110" y="171">THE WATERFALL WARREN</text>
  <g class="ref-scale" transform="translate(81 1175)"><text x="147" y="-23">1 square = 5 feet</text><path d="M0 -6 V6 M0 0 H294 M147 -6 V6 M294 -6 V6" /><text x="0" y="29">0</text><text x="147" y="29">25</text><text x="294" y="29">50 ft</text></g>
  <g class="m-compass" transform="translate(155 1061) scale(2)"><circle r="18" /><line x1="0" y1="13" x2="0" y2="-9" /><path class="m-compass-arrow" d="M0 -16 L5 -5 L0 -8 L-5 -5 Z" /><text y="-25">N</text></g>
</g>
