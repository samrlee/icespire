---
// Local map of Gnomengarde, traced feature-by-feature against the official
// map (offical-assets/Maps/map-07.02-gnomengarde.png, 2888 × 1838 —
// reference only, never shipped). Uniform mapping: my = official_px ×
// 0.31163 (900/2888), no offset; viewBox 900 × 573; north is up.
// Official grid: 1 square = 5 feet ≈ 11.4 units, so 50 feet ≈ 114 units.

// Cliff-edge hatching: bands of short ticks along slope lines, as
// [x0, y0, x1, y1, count]; ticks drawn perpendicular to each band.
const cliffBands: [number, number, number, number, number][] = [
  [428, 262, 440, 330, 7], [442, 340, 452, 400, 6], [488, 440, 512, 492, 6],
  [572, 200, 585, 260, 6], [592, 285, 602, 350, 7], [606, 360, 600, 415, 5],
  [630, 440, 652, 452, 4], [660, 460, 690, 472, 5],
];
const cliffTicks: { x: number; y: number; rot: number }[] = [];
for (const [x0, y0, x1, y1, n] of cliffBands) {
  const rot = (Math.atan2(y1 - y0, x1 - x0) * 180) / Math.PI + 90;
  for (let i = 0; i < n; i++) {
    const t = n === 1 ? 0.5 : i / (n - 1);
    cliffTicks.push({ x: x0 + (x1 - x0) * t, y: y0 + (y1 - y0) * t, rot });
  }
}

// Mushroom farm dots on the two pool isles.
const mushrooms: [number, number][] = [
  // North isle
  [504, 300], [513, 305], [521, 311], [503, 313], [511, 318], [520, 324],
  [504, 326], [512, 331], [520, 336], [506, 338], [514, 342], [509, 296],
  [523, 318], [507, 308],
  // South isle
  [552, 362], [559, 366], [554, 371], [561, 375], [552, 380], [559, 384],
  [555, 389], [562, 368], [557, 358], [561, 391],
];

// Barrels in the storage room.
const barrels: [number, number][] = [
  [748, 309], [761, 309], [774, 309], [787, 309], [797, 309],
  [842, 321], [842, 339], [842, 357], [842, 376], [842, 394], [842, 411],
  [738, 428], [751, 428], [764, 428], [777, 428], [790, 428],
];

// Pebbles and boulders on the gorge shelves.
const boulders: [number, number, number][] = [
  [485, 116, 3], [498, 148, 2.4], [511, 177, 3.2], [489, 206, 2.2],
  [514, 225, 2.8], [579, 206, 2.4], [586, 231, 3], [572, 254, 2.6],
  [455, 270, 2.2], [452, 300, 3], [460, 330, 2.4], [470, 360, 2.8],
];
