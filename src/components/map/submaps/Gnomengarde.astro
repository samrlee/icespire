function cliffLines(points: number[][], direction: number) {
 return points.slice(1).flatMap((b,i) => {
   const a=points[i], dx=b[0]-a[0], dy=b[1]-a[1], len=Math.hypot(dx,dy), count=Math.ceil(len/12);
   return Array.from({length:count},(_,j)=>{
     const t=j/count, x=a[0]+dx*t, y=a[1]+dy*t, reach=25+Math.sin(i*3+j)*8;
     return `M${x} ${y} q${-dy/len*reach*direction*.5+3} ${dx/len*reach*direction*.5} ${-dy/len*reach*direction} ${dx/len*reach*direction}`;
   });
 });
}
const islands = ['M1105 634 Q1134 611 1153 641 Q1167 665 1157 699 Q1170 733 1154 751 Q1136 760 1111 738 Q1093 723 1099 700 Q1085 659 1105 634 Z','M1204 813 Q1224 794 1240 815 Q1259 841 1243 874 Q1225 904 1205 884 Q1187 856 1204 813 Z'];
