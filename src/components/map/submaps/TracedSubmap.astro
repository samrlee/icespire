---
// Renders one traced local map: the geometry comes from
// src/components/map/submaps/traced/<slug>.ts (generated by
// scripts/trace_local_maps.py off the official sheet), everything about how it
// looks comes from the campaign's own palette in global.css.
import type { TracedMap } from './traced/types';

interface Props {
  map: TracedMap;
}

const { map } = Astro.props;

// A scale bar drawn from the grid the sheet was measured against. Pick the
// longest round distance that still leaves most of the map beside it.
const scaleSteps = [10, 25, 50, 100, 250, 500, 1000];
const feet = map.feetPerUnit;
const barFeet = feet
  ? [...scaleSteps].reverse().find((step) => step / feet <= map.width * 0.26)
  : undefined;
const barUnits = barFeet && feet ? barFeet / feet : 0;

const compassX = map.width - 46;
---

<g class="submap-traced" aria-hidden="true">
  {map.woods && <path class="sm-woods" d={map.woods} fill-rule="evenodd" />}
  {map.water && <path class="sm-water" d={map.water} fill-rule="evenodd" />}
  {map.roads && <path class="sm-roads" d={map.roads} fill-rule="evenodd" />}
  {map.floor && <path class="sm-floor" d={map.floor} fill-rule="evenodd" />}
  {map.buildings && <path class="sm-building" d={map.buildings} fill-rule="evenodd" />}
  {map.ink && <path class="sm-ink" d={map.ink} fill-rule="evenodd" />}

  {
    map.pois.map((poi, i) =>
      poi.x === undefined || poi.y === undefined ? null : (
      <g
        class={`sm-poi${poi.danger ? ' danger' : ''}`}
        data-tip-title={poi.label}
        data-tip-sub={poi.note}
      >
        <circle cx={poi.x} cy={poi.y} r="9" />
        <text x={poi.x} y={poi.y}>
          {i + 1}
        </text>
      </g>
      )
    )
  }

  {
    barFeet && (
      <g class="sm-scale" transform={`translate(38 ${map.height - 24})`}>
        <line x1="0" y1="0" x2={barUnits} y2="0" />
        <line x1="0" y1="-4" x2="0" y2="4" />
        <line x1={barUnits} y1="-4" x2={barUnits} y2="4" />
        <text x={barUnits / 2} y="-8">
          {barFeet} feet
        </text>
      </g>
    )
  }

  <g class="m-compass" transform={`translate(${compassX} 44)`}>
    <circle r="16"></circle>
    <line x1="0" y1="11" x2="0" y2="-8"></line>
    <path class="m-compass-arrow" d="M0 -14 L4.5 -4.5 L0 -7 L-4.5 -4.5 Z"></path>
    <text y="-22">N</text>
  </g>
</g>
