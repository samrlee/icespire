---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusPill from '../../components/StatusPill.astro';
import { url } from '../../utils/url';

export async function getStaticPaths() {
  const npcs = await getCollection('npcs');
  return npcs.map((npc) => ({ params: { id: npc.id }, props: { npc } }));
}

const { npc } = Astro.props;
const { Content } = await render(npc);
const roleLine = [npc.data.role, npc.data.affiliation].filter(Boolean).join(' · ');

// Resolve the faction slug rather than trusting it: an unresolved slug used to
// render as a link to a 404, labelled with the raw slug. The map page throws on
// this and the graph page skips it — match the graph and fail quietly.
const faction = npc.data.faction
  ? (await getCollection('factions')).find((f) => f.id === npc.data.faction)
  : undefined;
---

<Base title={npc.data.name} description={npc.data.note}>
  <a class="backlink" href={url('/npcs/')}>← NPC directory</a>
  <div class="kicker">NPC</div>
  <h1 class="page-title" style="margin-bottom: var(--space-3);">{npc.data.name}</h1>
  <p class="session-meta" style="display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
    {roleLine && <span>{roleLine}</span>}
    <StatusPill status={npc.data.status} />
    {npc.data.firstAppearance != null && (
      <span>First appeared in session {npc.data.firstAppearance}</span>
    )}
  </p>
  {
    faction && (
      <p class="session-meta">
        Faction: <a href={url(`/factions/${faction.id}/`)}>{faction.data.name}</a>
      </p>
    )
  }
  <div class={`npc-layout${npc.data.portrait ? '' : ' no-aside'}`}>
    <div class="prose">
      <Content />
    </div>
    {
      npc.data.portrait && (
        <figure class="creature-card npc-portrait-card">
          <div class="creature-art">
            <img src={url(npc.data.portrait)} alt={`Official art of ${npc.data.name}`} />
          </div>
          <figcaption class="creature-note">Official art</figcaption>
        </figure>
      )
    }
  </div>
</Base>
